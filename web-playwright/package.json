{
  "name": "@qavajs/demo",
  "version": "1.0.0",
  "description": "demo repository that demonstrates framework capabilities",
  "main": "index.js",
  "scripts": {
    "test": "qavajs run --config config.ts",
    "test:headless": "qavajs run --config config.ts --profile headless",
    "test:lambdatest": "qavajs run --config config.ts --profile lambdaTest",
    "serve:report": "allure generate && allure serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qavajs/demo.git"
  },
  "authors": [
    "Alexandr Galichenko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/qavajs/demo/issues"
  },
  "homepage": "https://github.com/qavajs/demo#readme",
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@qavajs/console-formatter": "^1.2.1",
    "@qavajs/core": "^2.17.0",
    "@qavajs/html-formatter": "^1.3.0",
    "@qavajs/memory": "^1.11.0",
    "@qavajs/steps-playwright": "^2.18.0",
    "@qavajs/validation": "^1.6.3",
    "allure": "^3.22.1",
    "allure-cucumberjs": "^3.14.0",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5"
  }
}
