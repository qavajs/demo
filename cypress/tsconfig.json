{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "es2020",
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["cypress"]
  },
  "include": [
    "**/*.ts",
    "node_modules/cypress/types"
  ],
  "exclude": [
    "node_modules"
  ]
}
