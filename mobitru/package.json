    "@qavajs/core": "^2.18.1",
    "@qavajs/html-formatter": "^1.4.0",
    "@qavajs/steps-memory": "^2.1.1",
    "@qavajs/steps-wdio": "^3.0.0",
    "dotenv": "^18.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
